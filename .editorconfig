# Dafny.cs is generated by the build (see README.md). Silence the warnings Dafny's own header says
# its output triggers; they apply to this file only, so warnings in hand-written code still show.
# Deliberately NOT marked generated_code = true: that would make C# treat Dafny.cs as
# nullable-oblivious, and passing null to a Dafny method would no longer warn (CS8625).
[Dafny.cs]
dotnet_diagnostic.CS0162.severity = none
dotnet_diagnostic.CS0164.severity = none
dotnet_diagnostic.CS0168.severity = none
dotnet_diagnostic.CS0183.severity = none
dotnet_diagnostic.CS0219.severity = none
dotnet_diagnostic.CS0436.severity = none
dotnet_diagnostic.CS1717.severity = none
dotnet_diagnostic.CS1718.severity = none
