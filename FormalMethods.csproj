<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The Dafny version this project is built with. The dafny tool and the DafnyRuntime package
         must be the same version; the build checks the installed tool against this. -->
    <DafnyVersion>4.11.0</DafnyVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DafnyRuntime" Version="$(DafnyVersion)" />
  </ItemGroup>

  <!--
    Dafny pre-build step: every .dfy file in this project is verified and translated into
    $(DafnyOutputName).cs in the project folder. If a proof fails, the build fails.

    All .dfy files go into ONE .cs file because each Dafny translation also emits shared helper
    code (Dafny.ArrayHelpers, FuncExtensions, an assembly attribute); two separately translated
    files would define those twice and fail to compile.

    The generated file is overwritten on every translation: edit the .dfy files, never the .cs.
  -->
  <PropertyGroup>
    <!-- Default Z3 location; override with a DafnySolverPath environment variable or
         `dotnet build -p:DafnySolverPath=...` (see README.md). -->
    <DafnySolverPath Condition="'$(DafnySolverPath)' == ''">$(USERPROFILE)\Documents\repos\z3\bin\z3.exe</DafnySolverPath>
    <DafnyOutputName>Dafny</DafnyOutputName>
    <DafnyOutputFile>$(MSBuildProjectDirectory)\$(DafnyOutputName).cs</DafnyOutputFile>
  </PropertyGroup>

  <ItemGroup>
    <DafnySource Include="**\*.dfy" Exclude="bin\**;obj\**" />
    <!-- Copies left by running `dafny translate` by hand on a single .dfy are ignored so they can't
         clash with the generated file. The generated file itself stays in, so the editor sees it. -->
    <_DafnyStrayCs Include="@(DafnySource->'%(RelativeDir)%(Filename).cs')" Exclude="$(DafnyOutputName).cs" />
    <Compile Remove="@(_DafnyStrayCs)" />
    <None Remove="*-cs.dtr" />
    <!-- Visual Studio's fast up-to-date check skips MSBuild entirely unless it knows about an input
         that changed; without this, editing only a .dfy and pressing F5 would not rebuild. -->
    <UpToDateCheckInput Include="@(DafnySource)" />
  </ItemGroup>

  <!-- Records which .dfy files exist. The file is only rewritten when that list changes, so adding a
       .dfy (even one with an old timestamp) or deleting one makes DafnyTranslate run again. -->
  <Target Name="DafnyWriteSourceList" BeforeTargets="DafnyTranslate">
    <PropertyGroup>
      <DafnySourceListFile>$(IntermediateOutputPath)DafnySources.txt</DafnySourceListFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(DafnySourceListFile)" Lines="@(DafnySource)" Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <FileWrites Include="$(DafnySourceListFile)" />
    </ItemGroup>
  </Target>

  <!-- Only re-runs Dafny when a .dfy file, the list of .dfy files, or this project file is newer
       than the generated C#. -->
  <Target Name="DafnyTranslate" BeforeTargets="BeforeBuild" Condition="'@(DafnySource)' != ''"
          Inputs="@(DafnySource);$(DafnySourceListFile);$(MSBuildProjectFullPath)" Outputs="$(DafnyOutputFile)">
    <!-- Tool checks. They run only when Dafny is about to run, so a machine that already has an
         up-to-date Dafny.cs can still build without the tools. -->

    <!-- 1. Is the dafny tool installed? -->
    <Exec Command="dafny --version" ConsoleToMSBuild="true" IgnoreExitCode="true" EchoOff="true"
          StandardOutputImportance="low" StandardErrorImportance="low" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_DafnyExitCode" />
      <Output TaskParameter="ConsoleOutput" PropertyName="_DafnyVersionOutput" />
    </Exec>
    <Error Condition="'$(_DafnyExitCode)' != '0'"
           Text="Dafny is not installed (the 'dafny' command was not found). Install it with: dotnet tool install -g dafny --version $(DafnyVersion)   Then open a new terminal, or restart Visual Studio, and build again. See README.md." />

    <!-- 2. Is it the version this project needs? dafny prints e.g. "4.11.0+fcb2042...". -->
    <PropertyGroup>
      <_DafnyInstalledVersion>$([System.Text.RegularExpressions.Regex]::Replace('$(_DafnyVersionOutput)', '\+.*$', '').Trim())</_DafnyInstalledVersion>
    </PropertyGroup>
    <Error Condition="'$(_DafnyInstalledVersion)' != '$(DafnyVersion)'"
           Text="Dafny $(_DafnyInstalledVersion) is installed, but this project needs Dafny $(DafnyVersion) (it must match the DafnyRuntime package). Switch with: dotnet tool uninstall -g dafny   then: dotnet tool install -g dafny --version $(DafnyVersion)   Or change DafnyVersion in FormalMethods.csproj to $(_DafnyInstalledVersion). See README.md." />

    <!-- 3. Is Z3 where the build expects it, and does it run? -->
    <Error Condition="!Exists('$(DafnySolverPath)')"
           Text="Z3 not found at '$(DafnySolverPath)'. Download it from https://github.com/Z3Prover/z3/releases and extract it so z3.exe is at that path, or set DafnySolverPath to where z3.exe is. See README.md." />
    <Exec Command="&quot;$(DafnySolverPath)&quot; --version" ConsoleToMSBuild="true" IgnoreExitCode="true" EchoOff="true"
          StandardOutputImportance="low" StandardErrorImportance="low" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_Z3ExitCode" />
    </Exec>
    <Error Condition="'$(_Z3ExitCode)' != '0'"
           Text="Z3 at '$(DafnySolverPath)' did not run. Re-download it from https://github.com/Z3Prover/z3/releases (pick the zip for your platform, e.g. x64-win). See README.md." />
    <!-- Dafny copies its command line into the generated file, so pass only paths relative to the
         project folder; full paths would expose the local folder layout (user name etc.). -->
    <PropertyGroup>
      <_DafnySolverRelPath>$([MSBuild]::MakeRelative('$(MSBuildProjectDirectory)\', '$(DafnySolverPath)'))</_DafnySolverRelPath>
    </PropertyGroup>
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="dafny translate cs @(DafnySource->'&quot;%(Identity)&quot;', ' ') --solver-path &quot;$(_DafnySolverRelPath)&quot; --output &quot;$(DafnyOutputName)&quot;" />
    <Delete Files="$(MSBuildProjectDirectory)\$(DafnyOutputName)-cs.dtr" />
  </Target>

  <Target Name="DafnyIncludeGenerated" AfterTargets="DafnyTranslate" BeforeTargets="BeforeBuild"
          Condition="'@(DafnySource)' != ''">
    <!-- On a clean build the file didn't exist when the project was loaded, so add it now;
         remove first so it isn't listed twice when it did exist. -->
    <ItemGroup>
      <Compile Remove="$(DafnyOutputName).cs" />
      <Compile Include="$(DafnyOutputName).cs" />
    </ItemGroup>
  </Target>

</Project>
